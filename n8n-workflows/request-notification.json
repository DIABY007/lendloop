{
  "name": "LendLoop — Request Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lendloop-request",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "10000000-0000-0000-0000-000000000001",
      "name": "Convex Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "lendloop-request-webhook"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\n// Retrieve HMAC signature from header\nconst headers = $input.item.json.headers;\nconst signature = headers['x-convex-signature'] || headers['X-Convex-Signature'];\n\n// Get shared secret from environment variables\nconst secret = 'lendloop_shared_hmac_secret_key_2026';\n\nconst body = $input.item.json.body;\nconst rawBody = typeof body === 'string' ? body : JSON.stringify(body);\n\n// Calculate expected signature\nconst expectedSignature = crypto\n  .createHmac('sha256', secret)\n  .update(rawBody)\n  .digest('hex');\n\nconst sigBuf = signature ? Buffer.from(signature) : null;\nconst expBuf = Buffer.from(expectedSignature);\nconst isValid = Boolean(sigBuf && sigBuf.length === expBuf.length && crypto.timingSafeEqual(sigBuf, expBuf));\n\nreturn [{\n  json: {\n    isValid: Boolean(isValid),\n    payload: typeof body === 'string' ? JSON.parse(body) : body\n  }\n}];"
      },
      "id": "10000000-0000-0000-0000-000000000002",
      "name": "Verify HMAC Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isValid }}",
              "value2": true
            }
          ]
        }
      },
      "id": "10000000-0000-0000-0000-000000000003",
      "name": "Is Signature Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"error\": \"forbidden\",\n  \"message\": \"Cryptographic HMAC signature verification failed\"\n}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "10000000-0000-0000-0000-000000000004",
      "name": "Reject 403",
      "type": "n8n-nodes-base.respondToWebhook",
