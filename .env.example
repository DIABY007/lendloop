# ==============================================================================
# LendLoop — Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Convex (Backend & Realtime Database)
# Obtained via `npx convex dev`
# ------------------------------------------------------------------------------
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# ------------------------------------------------------------------------------
# 2. Clerk (Authentication)
# From Clerk Dashboard: https://dashboard.clerk.com -> API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# 3. n8n Automation Engine & Webhooks
# ------------------------------------------------------------------------------
# n8n Webhook URL called by Convex when requests are created/updated
N8N_WEBHOOK_URL=https://neocodex.app.n8n.cloud/webhook/lendloop-request
# Shared HMAC secret for verifying Convex -> n8n webhook calls
N8N_WEBHOOK_SECRET=lendloop_shared_hmac_secret_key_2026
# Shared secret for authenticating n8n -> Convex HTTP calls
CONVEX_N8N_API_SECRET=lendloop_convex_api_bearer_token_2026

# ------------------------------------------------------------------------------
# 4. Optional: Self-hosted n8n credentials (if using docker-compose.yml)
# ------------------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=lendloop_secure_admin_password
